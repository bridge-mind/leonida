{
  "name": "leonida",
  "private": true,
  "version": "0.1.0",
  "description": "LEONIDA - a GTA VI-style open-world sandbox in Three.js (non-commercial fan project)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
