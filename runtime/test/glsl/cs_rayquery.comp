#version 460
// Minimal RayQueryKHR compute shader for d3d12_indirect_rt_test:
// Invocation 0 casts a ray that hits the BLAS/TLAS triangle at z=0; invocation 1 casts a ray that misses.
#extension GL_EXT_ray_query : require

layout(local_size_x = 2) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, std430) writeonly buffer Result {
    uint hit[];
};

void main() {
    const uint id = gl_GlobalInvocationID.x;
    const vec3 origin = (id == 0u) ? vec3(0.25, 0.25, 1.0) : vec3(10.0, 10.0, 1.0);
    const vec3 dir = vec3(0.0, 0.0, -1.0);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                          0xFF, origin, 0.001, dir, 10.0);
    while (rayQueryProceedEXT(rq)) {}
    hit[id] = (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) ? 1u : 0u;
}
