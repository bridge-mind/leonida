#version 460
// A mesh shader written to the translator's runtime contract (docs/design.md, "User data" and "Mesh shaders"),
// standing in for a translated one in d3d12_mesh_test. Each workgroup emits one quad (4 vertices, 2 triangles) on a
// 4x4 grid of clip-space cells: column = WorkgroupId.x + WorkgroupId.z, row = WorkgroupId.y, so all three
// DispatchMesh counts reach the shader. s0, s1 (root constants) move the quad in clip space; the colour is red. The
// corners are top-left, top-right, bottom-left, bottom-right and the triangles (0,1,2) and (2,1,3), clockwise in D3D
// screen space as in d3d12_draw_test, so they are front-facing with the default winding.
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 32) in;
layout(triangles, max_vertices = 4, max_primitives = 2) out;

layout(location = 0) out vec4 out_color[];

layout(push_constant) uniform UserData {
    uint s[32];
    uvec2 heap_base;
    uvec2 code_base;
} pc;

void main() {
    SetMeshOutputsEXT(4, 2);
    const uint i = gl_LocalInvocationIndex;
    const float column = float(gl_WorkGroupID.x + gl_WorkGroupID.z), row = float(gl_WorkGroupID.y);
    const vec2 offset = vec2(uintBitsToFloat(pc.s[0]), uintBitsToFloat(pc.s[1]));
    if (i < 4) {
        const vec2 corner = vec2(float(i & 1u), float(i >> 1));
        const vec2 top_left = vec2(-1.0 + 0.5 * column, 1.0 - 0.5 * row);
        gl_MeshVerticesEXT[i].gl_Position = vec4(top_left + vec2(0.5, -0.5) * corner + offset, 0.0, 1.0);
        out_color[i] = vec4(1.0, 0.0, 0.0, 1.0);
    }
    if (i == 0) gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    if (i == 1) gl_PrimitiveTriangleIndicesEXT[1] = uvec3(2, 1, 3);
}
